# Dependencias / regenerables
node_modules/
.venv/
__pycache__/
*.pyc

# Builds .NET (api/publish/Madrid.Api.exe solo es self-contained de ~111MB,
# excede el límite de 100MB/archivo de GitHub -- de todas formas se regenera
# con dotnet publish, ver RECOVERY.md)
bin/
obj/
api/publish/

# Build Next.js
.next/
web/.next/

# Artefactos del instalador (se recompilan, no versionar binarios grandes)
installer/Output/
installer/runtime/

# Secretos -- nunca subir claves reales
.env
.env.local
.env.production
ml-service/.env
!installer/scripts/.env.example
!ml-service/.env.example

# SQLite locales -- excepto el snapshot que necesita el instalador (~4MB, se
# versiona a propósito para poder compilar el instalador sin SQL Server)
*.db
*.db-shm
*.db-wal
!desktop/madrid.db

# Archivos comprimidos sueltos
*.rar
*.zip

# Misc
.DS_Store
Thumbs.db
