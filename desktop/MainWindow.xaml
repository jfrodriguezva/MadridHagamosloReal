<Window x:Class="Madrid.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Madrid Hagámoslo Real" Height="900" Width="1400"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#2b2350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de estado de arranque -->
        <Border x:Name="StatusBar" Grid.Row="0" Background="#2b2350" Padding="16,10" Visibility="Visible">
            <TextBlock x:Name="StatusText" Foreground="#d9b95c" FontFamily="Consolas" FontSize="12"
                       Text="Iniciando Madrid Hagámoslo Real…"/>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
