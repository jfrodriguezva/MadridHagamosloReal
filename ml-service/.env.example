# Copia este archivo como ".env" en esta misma carpeta (ml-service/) -- lo
# leen db.py, los scripts fetch_*.py, train_model.py y seed_dev_db_from_sqlite.py.
# NUNCA iba trackeado en git (nunca existió como plantilla hasta ahora, aunque
# .gitignore ya lo esperaba) -- esto es solo la plantilla, sin secretos reales.

# --- SQL Server (dev) ---
SQL_SERVER=localhost
SQL_DATABASE=MadridHagamosloReal
# true = autenticación de Windows (recomendado si tu SQL Server la soporta,
# no necesitas usuario/password). false = usa SQL_USER/SQL_PASSWORD de abajo.
SQL_USE_WINDOWS_AUTH=true
SQL_USER=sa
SQL_PASSWORD=pega-aqui-tu-password

# --- API-Football (solo necesario para fetch_*.py, no para el seed desde SQLite) ---
API_FOOTBALL_KEY=pega-aqui-tu-api-key
API_FOOTBALL_BASE=https://v3.football.api-sports.io
REAL_MADRID_TEAM_ID=541
LALIGA_LEAGUE_ID=140
